# Variablat e mjedisit (opsionale; vlerat më poshtë janë ato të paracaktuarat).
# Projekti s'ka sekrete: modeli punon lokalisht përmes Ollama.
# Linux/macOS: export $(grep -v '^#' .env | xargs)   PowerShell: $env:OSINT_DB="demo.db"

# Baza SQLite (demo.py e mbush demo.db me artikujt sintetikë)
OSINT_DB=osint.db
# Ollama lokal dhe modeli
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=deepseek-r1:8b
