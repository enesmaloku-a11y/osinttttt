# Kopjoje si .env (s'hyn në Git) ose vendosi te variablat e Railway-t.
# Asnjë vlerë këtu s'është reale. Çelësat API mbahen vetëm në server.

# --- Baza dhe mënyra e punës ---
OSINT_DB=osint.db
# 1 = cloud (parazgjedhje në Linux), 0 = lokal (parazgjedhje në Windows)
OSINT_CLOUD=0
# Fjalëkalimi i faqes; pa të faqja është publike
OSINT_FJALEKALIMI=
# 1 = ngrin pipeline-in (p.sh. gjatë etiketimit)
OSINT_NGRIRE=

# --- Modeli kryesor: ollama (lokal) ose featherless (cloud) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=deepseek-r1:8b
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# --- Kontrolli i dytë AI (opsional; bosh = i fikur) ---
SECOND_LLM_PROVIDER=
SECOND_OLLAMA_MODEL=
SECOND_OLLAMA_URL=
SECOND_FEATHERLESS_MODEL=
SECOND_FEATHERLESS_API_KEY=
SECOND_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
SECOND_LLM_MAX_PER_RUN=3

# --- Rrjetet sociale përmes Apify (vetëm me leje të platformës) ---
APIFY_TOKEN=
# platformat e lejuara, p.sh. reddit,x
APIFY_LEJET=
# URL të subreddit-eve, të ndara me presje
APIFY_REDDIT_URLS=

# --- Demo live përmes Telegram Bot API (kanali i ekipit) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEMO_LIVE_DB=demo_live.db

# --- Konteksti i jashtëm: eksporti EuRepoC (parazgjedhje data/eurepoc.xlsx) ---
EUREPOC_XLSX=

# --- trajno.py: versioni i korrelatorit që shënohet në raportin e modelit ---
OSINT_VERSION_KORRELATORIT=
